# Copie este archivo como .env y ajuste los valores:
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows)
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Nombre corto del grupo (g1, g2, g3, ...). Los usuarios quedan como ana@g3.
GROUP_NAME=g3

# Puerto de este computador donde se expone el servidor.
HOST_PORT=8000

# URL con la que el servidor central nos alcanza.
# En la sesión de interoperabilidad: http://<IP-de-este-PC>:8000
PUBLIC_URL=http://localhost:8000

# URL del servidor central.
# Pruebas locales con mock_central.py corriendo en este PC:
#   http://host.docker.internal:9000
# En la sesión de clase: la URL que publique el profesor.
CENTRAL_URL=http://host.docker.internal:9000

# Detección de fallos del servidor central
MAX_HEALTH_FAILURES=3
HEARTBEAT_INTERVAL=5.0
REGISTER_INTERVAL=30.0
